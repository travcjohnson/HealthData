# ─── Supabase ───────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # anon / publishable key (safe for browser)
SUPABASE_SECRET_KEY=sb_secret_xxx                         # service-role / secret key (SERVER ONLY)

# Direct Postgres connection (Settings → Database → Connection string).
# Used by migration & seed scripts and the ingestion normalizer.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── LLM extraction (optional but recommended for PDF/photo labs) ─────────────
# Used by the ingestion pipeline to read unstructured lab PDFs & images.
ANTHROPIC_API_KEY=sk-ant-xxx
INGEST_LLM_MODEL=claude-sonnet-4-6

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
